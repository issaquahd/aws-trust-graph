        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "*"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
              "StringEquals": {
                "aws:PrincipalOrgID": "o-exampleorg1"
              }
            }
          }
        ]
      },
      "MaxSessionDuration": 3600
    },
    {
      "Path": "/",
