              "Service": "support.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "MaxSessionDuration": 3600
    },
    {
      "Path": "/",
      "RoleName": "sso-admins",
      "RoleId": "AROAEXAMPLESSOADMINS",
      "Arn": "arn:aws:iam::ACCOUNT_SELF:role/sso-admins",
      "CreateDate": "2026-01-15T10:00:00+00:00",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::ACCOUNT_SELF:saml-provider/ExampleIdP"
            },
            "Action": [
              "sts:AssumeRoleWithSAML",
              "sts:TagSession"
            ],
            "Condition": {
              "StringEquals": {
                "SAML:aud": "https://signin.aws.amazon.com/saml"
              }
            }
          }
        ]
      },
      "MaxSessionDuration": 3600
    },
    {
      "Path": "/",
      "RoleName": "shared-deploy",
      "RoleId": "AROAEXAMPLESHAREDDEPL",
      "Arn": "arn:aws:iam::ACCOUNT_SELF:role/shared-deploy",
      "CreateDate": "2026-01-15T10:00:00+00:00",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": [
                "arn:aws:iam::ACCOUNT_THIRD:role/deploy",
                "arn:aws:iam::ACCOUNT_THIRD:user/ci-bot"
              ]
            },
            "Action": "sts:AssumeRole"
          },
          {
            "Effect": "Deny",
            "Principal": {
              "AWS": "*"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
              "Bool": {
                "aws:SecureTransport": "false"
              }
            }
          }
        ]
      },
      "MaxSessionDuration": 3600
    }
