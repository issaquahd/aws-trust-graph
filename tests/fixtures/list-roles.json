{
  "Roles": [
    {
      "Path": "/",
      "RoleName": "lambda-exec",
      "RoleId": "AROAEXAMPLELAMBDAEXEC",
      "Arn": "arn:aws:iam::ACCOUNT_SELF:role/lambda-exec",
      "CreateDate": "2026-01-15T10:00:00+00:00",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Service": "lambda.amazonaws.com"
            },
            "Action": "sts:AssumeRole"
          }
        ]
      },
      "MaxSessionDuration": 3600
    },
    {
      "Path": "/",
      "RoleName": "github-deployer",
      "RoleId": "AROAEXAMPLEGITHUBDEPL",
      "Arn": "arn:aws:iam::ACCOUNT_SELF:role/github-deployer",
      "CreateDate": "2026-01-15T10:00:00+00:00",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::ACCOUNT_SELF:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
              "StringEquals": {
                "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                "token.actions.githubusercontent.com:sub": "repo:example-org/example-repo:ref:refs/heads/main"
              }
            }
          }
        ]
      },
      "MaxSessionDuration": 3600
    },
    {
      "Path": "/",
      "RoleName": "oidc-any-repo",
      "RoleId": "AROAEXAMPLEOIDCANYREP",
      "Arn": "arn:aws:iam::ACCOUNT_SELF:role/oidc-any-repo",
      "CreateDate": "2026-01-15T10:00:00+00:00",
      "AssumeRolePolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "Federated": "arn:aws:iam::ACCOUNT_SELF:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity"
          }
        ]
      },
      "MaxSessionDuration": 3600
    },
    {
