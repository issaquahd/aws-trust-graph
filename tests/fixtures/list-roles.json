        "Version": "2012-10-17",
        "Statement": [
          {
            "Effect": "Allow",
            "Principal": {
              "AWS": "arn:aws:iam::ACCOUNT_PARTNER:root"
            },
            "Action": "sts:AssumeRole",
            "Condition": {
              "StringEquals": {
                "sts:ExternalId": "example-external-id"
              }
            }
          }
        ]
      },
      "MaxSessionDuration": 3600
    },
    {
      "Path": "/",
      "RoleName": "vendor-audit",
      "RoleId": "AROAEXAMPLEVENDORAUDI",
